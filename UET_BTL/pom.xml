<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>vn.uet</groupId>
  <artifactId>online-auction</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>UET Online Auction - Project Scaffold</name>
  <properties>
    <!-- Java 17 là lựa chọn khởi đầu; cả nhóm thống nhất trước khi đổi. -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <javafx.version>17.0.21</javafx.version>
    <junit.version>6.1.3</junit.version>
  </properties>
  <dependencies>
    <!-- TV2 bổ sung theo yêu cầu người dùng 2026-11-05; TV4 tiếp tục sở hữu build. -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <!-- JUnit: thư viện viết test, chỉ dùng khi chạy test -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <!-- Đo coverage khi chạy test, chưa đặt ngưỡng cho tuần 8. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.14</version>
        <executions>
          <execution>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>coverage-report</id>
            <phase>test</phase>
            <goals><goal>report</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <!-- TV4 triển khai ClientApp trước khi chạy javafx:run. -->
          <mainClass>vn.uet.auction.client.ClientApp</mainClass>
        </configuration>
      </plugin>
      <!-- Surefire: plugin tìm và chạy test; ghim phiên bản để mọi máy và CI chạy giống nhau -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
      </plugin>
    </plugins>
  </build>
  <!-- TV4 tiếp tục hoàn thiện ClientApp và cấu hình build.
       Tuần9: hoàn thiện Maven, Checkstyle, GitHub Actions.
       Tuần10: cấu hình JaCoCo và kiểm tra coverage >=60%. -->
</project>
